# Stripe Configuration
# These are test mode keys - safe to use for development/demo
# Get your own test keys from: https://dashboard.stripe.com/test/apikeys

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Webhook secret will be automatically configured by build.sh
# Leave this empty - it will be populated when you run: ./build.sh up
STRIPE_WEBHOOK_SECRET=
